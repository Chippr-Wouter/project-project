{
  "name": "projectproject",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "vp run --filter @projectproject/backend dev",
    "dev:frontend": "vp run --filter @projectproject/frontend dev",
    "dev:db": "docker compose up --wait --wait-timeout 60 postgres",
    "dev:stop": "docker compose stop postgres",
    "dev": "vp run dev:db && vp run --filter @projectproject/backend --filter @projectproject/frontend --parallel dev",
    "build": "vp run --filter @projectproject/frontend build",
    "test": "vp test run",
    "typecheck": "vp run -r typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "prepare": "effect-tsgo patch",
    "check": "vp check && vp run typecheck",
    "test:db": "vp test run --project backend packages/backend/src/db packages/backend/src/Layers/OAuthApplications.test.ts --no-file-parallelism"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "kysely": "0.27.6",
    "typescript": "7.0.2",
    "@effect/tsgo": "0.41.0",
    "vite-plus": "0.3.0",
    "effect": "4.0.0-rc.112"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "bun": ">=1.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  }
}
