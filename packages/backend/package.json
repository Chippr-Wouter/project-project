{
  "name": "@projectproject/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "mcp": "bun --env-file=../../.env src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env vitest run",
    "test:watch": "bun --env-file=../../.env vitest",
    "bootstrap:org": "bun --env-file=../../.env scripts/bootstrap-org.ts",
    "migrate:orgs": "bun --env-file=../../.env scripts/migrate-orgs.ts",
    "migrate:relayout": "bun --env-file=../../.env scripts/relayout-data.ts",
    "benchmark:ticket-storage": "bun scripts/benchmark-ticket-storage.ts",
    "benchmark:ticket-requests": "bun scripts/benchmark-ticket-request-paths.ts",
    "ticket-index:rebuild": "bun --env-file=../../.env scripts/rebuild-ticket-index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@effect/platform": "0.96.1",
    "@effect/platform-bun": "0.90.0",
    "@effect/sql": "^0.51.1",
    "@effect/sql-drizzle": "^0.50.0",
    "@effect/sql-pg": "^0.52.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/graphql": "^9.0.3",
    "@projectproject/shared": "workspace:*",
    "better-auth": "^1.6.10",
    "drizzle-orm": "^0.45.2",
    "effect": "3.21.2",
    "fractional-indexing": "^3.2.0",
    "gray-matter": "^4.0.3",
    "octokit": "^5.0.5",
    "pg": "^8.20.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "vitest": "^3.2.0"
  }
}
