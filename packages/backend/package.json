{
  "name": "@projectproject/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "mcp": "bun --env-file=../../.env src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "bootstrap:org": "bun --env-file=../../.env scripts/bootstrap-org.ts",
    "migrate:orgs": "bun --env-file=../../.env scripts/migrate-orgs.ts",
    "migrate:relayout": "bun --env-file=../../.env scripts/relayout-data.ts",
    "ticket-index:rebuild": "bun --env-file=../../.env scripts/rebuild-ticket-index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/graphql": "^9.0.3",
    "@projectproject/shared": "workspace:*",
    "better-auth": "1.7.3",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "fractional-indexing": "^3.2.0",
    "gray-matter": "^4.0.3",
    "octokit": "^5.0.5",
    "pg": "^8.20.0",
    "ulid": "^3.0.2",
    "@better-auth/mcp": "1.7.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vite-plus": "0.3.0"
  }
}
