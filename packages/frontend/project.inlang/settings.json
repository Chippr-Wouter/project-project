{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": ["en"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-message-format@latest/dist/index.js"
  ],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/{locale}/common.json",
      "./messages/{locale}/shell.json",
      "./messages/{locale}/account.json",
      "./messages/{locale}/projects.json",
      "./messages/{locale}/tickets.json",
      "./messages/{locale}/tags.json",
      "./messages/{locale}/git.json",
      "./messages/{locale}/comments.json",
      "./messages/{locale}/sprints.json",
      "./messages/{locale}/time.json",
      "./messages/{locale}/figma.json"
    ]
  }
}
