# Production .env shape — copy to /srv/projectproject/.env on the deploy
# VM and fill in. NEVER commit a populated copy of this file.

# Required for docker-compose substitution
IMAGE_OWNER=your-github-username
# IMAGE_TAG=latest                    # uncomment to pin a specific tag

# Where the app's bind-mounted markdown projects live on the VM. Created
# automatically by docker on first start.
MARKMATE_DATA_DIR=/srv/projectproject/data

# Bind port for the `web` container. nginx-proxy-manager forwards traffic
# from the public hostname to this port.
WEB_PORT=8080

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=projectproject
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=projectproject

# --- Auth -------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# --- GitHub App -------------------------------------------------------------
# Separate from the personal GitHub OAuth app above. The GitHub App installs
# onto a GitHub organization and powers org/project repository reads.
#
# Register the GitHub App with:
#   Setup URL:    <BETTER_AUTH_URL>/api/integrations/github/setup
#   Callback URL: <BETTER_AUTH_URL>/api/integrations/github/callback
#   Webhook URL:  <BETTER_AUTH_URL>/api/integrations/github/webhook
#   Events:       installation, installation_repositories
#
# GITHUB_APP_PRIVATE_KEY accepts either raw PEM with escaped \n or base64 PEM.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new
# Must match the webhook secret configured on the GitHub App.
GITHUB_APP_WEBHOOK_SECRET=

# Public-facing URL. Must match the GitHub OAuth app's callback prefix:
#   <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_URL=https://projectproject.example.com

# --- Org bootstrap ----------------------------------------------------------
# Run once after migrations, and safely re-run whenever needed:
#   docker compose run --rm app bun run bootstrap:org
BOOTSTRAP_ORG_SLUG=project-project
BOOTSTRAP_ORG_NAME=ProjectProject
BOOTSTRAP_OWNER_EMAIL=you@example.com
BOOTSTRAP_OWNER_NAME=Your Name
BOOTSTRAP_OWNER_USERNAME=your-github-username

# --- Figma integration ------------------------------------------------------
# From a Figma OAuth app at https://www.figma.com/developers/apps, owned by the
# team rather than a personal account. Register the callback URL on it:
#   <BETTER_AUTH_URL>/api/integrations/figma/oauth/callback
# Scopes: file_content:read file_metadata:read file_dev_resources:read
#         file_dev_resources:write
# Without these, per-user Figma connections fail with a configuration error;
# project-level connections (personal access tokens) keep working.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
