# Bind-mounted markdown content; not source code
data/

# `routeTree.gen.ts` is generated by @tanstack/router-plugin on `vite dev`.
# We commit a placeholder so the repo typechecks from a fresh clone; the
# plugin overwrites it on first dev run. We accept the diff churn.

# Bun
.bun

# Serena MCP server's per-project state. Its own internal .gitignore
# already excludes the cache and project.local.yml, but the remaining
# files (project.yml, memories) are tied to a single developer's setup —
# don't share via the repo.
.serena/
storage/

